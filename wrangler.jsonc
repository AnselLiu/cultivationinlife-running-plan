{
  // 耕跑團 Cultivation in Life Run — Cloudflare Worker（API）＋ 靜態資源（PWA）＋ D1 資料庫
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cil-run",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 一定先進 Worker，其他路徑直接回靜態檔
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cil-run",
      // 第一次部署前先建資料庫：npx wrangler d1 create cil-run，再把 id 貼到這裡
      "database_id": "e246d3a3-a537-4c20-afcf-c0002ef669c2",
      "migrations_dir": "migrations"
    }
  ]
  ,
  // 排程：每小時整點跑一次（活動提醒、會費到期、每季權限檢視、每天 03:00 資料清理），時間判斷都用台北時間
  "triggers": { "crons": ["0 * * * *"] },
  // 錯誤監控：Cloudflare 後台 Workers → cil-run → Logs 可以看到錯誤與排程結果
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Smart Placement：API 一次請求要查好幾次資料庫，讓 Worker 跑在靠近 D1 的地方，比跑在使用者旁邊快（靜態檔仍由最近的節點回）
  "placement": { "mode": "smart" },
  // 每日加密備份：先存在 Workers KV；在 Cloudflare 後台啟用 R2 後，改綁 R2（"r2_buckets": [{ "binding": "BACKUP", "bucket_name": "cil-run-backup" }]）就會自動改存 R2
  "kv_namespaces": [{ "binding": "BACKUP_KV", "id": "8f91539529ab4d4faca88306d6e3ebf8" }],
  // 執行額度（src/budget.js）：PLAN＝free（每次執行 50 個子請求、CPU 10 ms）或 paid；沒設定或寫錯一律當 free
  //   JOB_DISPATCH＝inline（排程工作在同一次執行裡依優先順序跑，只有每日備份開自己的執行）或 self（每項工作都開自己的執行；
  //   要等 staging 驗證過「呼叫自己會拿到新的額度」才切換，只改這裡）。具名環境不會繼承 vars，staging 要再寫一次
  "vars": { "PLAN": "free", "JOB_DISPATCH": "inline" },
  // 測試環境：npm run deploy:staging → https://cil-run-staging.anselliu7.workers.dev（獨立資料庫，不影響正式站；不跑排程）
  "env": {
    "staging": {
      "name": "cil-run-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "cil-run-staging", "database_id": "08b71fd7-6681-4363-a670-558e3edf8e97", "migrations_dir": "migrations" }
      ],
      "triggers": { "crons": [] },
      "kv_namespaces": [{ "binding": "BACKUP_KV", "id": "f13b4414508140418e8fb9547d897aba" }],
      // SELFTEST：只在 staging 開 POST /api/admin/selftest（驗證呼叫自己會不會拿到新的額度）；正式站不要設
      "vars": { "PLAN": "free", "JOB_DISPATCH": "inline", "SELFTEST": "1" }
    }
  }
  // 設定值全部用 secrets（npx wrangler secret put 名稱 --name cil-run），不寫在這裡：
  //   JOIN_CODE             跑友加入用的邀請碼（在 LINE 群公告）
  //   CHAIR_CODE            一次性的初始理事長設定碼（有理事長之後自動失效）
  //   HASH_SALT             IP 雜湊用的鹽
  //   AUDIT_KEY             稽核紀錄防竄改的 HMAC 金鑰
  //   RACE_KEY              賽事報名資料（身分證字號等）的 AES-GCM 金鑰
  //   BACKUP_KEY            每日備份的 AES-GCM 金鑰（還原時要用，請另外保存在安全的地方）
  //   GOOGLE_CLIENT_ID／GOOGLE_CLIENT_SECRET   Google 登入
  //   VAPID_PUBLIC_KEY／VAPID_PRIVATE_JWK／VAPID_SUBJECT   推播
}
