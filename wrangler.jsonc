{
  // 耕跑團 Cultivation in Life Run — Cloudflare Worker（API）＋ 靜態資源（PWA）＋ D1 資料庫
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cil-run",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 一定先進 Worker，其他路徑直接回靜態檔
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cil-run",
      // 第一次部署前先建資料庫：npx wrangler d1 create cil-run，再把 id 貼到這裡
      "database_id": "e246d3a3-a537-4c20-afcf-c0002ef669c2",
      "migrations_dir": "migrations"
    }
  ]
  // 設定值全部用 secrets（npx wrangler secret put 名稱），不寫在這裡：
  //   JOIN_CODE             團員加入用的邀請碼（在 LINE 群公告）
  //   ADMIN_CODE            幹部用的邀請碼，輸入後身分是管理員
  //   VAPID_PUBLIC_KEY      推播公鑰（未壓縮公鑰 base64url）
  //   VAPID_PRIVATE_JWK     推播私鑰（JWK JSON）
  //   VAPID_SUBJECT         推播聯絡資訊，例如 mailto:xxx@example.com
}
