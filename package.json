{
  "name": "cultivationinlife-running-plan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "deploy": "wrangler d1 migrations apply cil-run --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cil-run --local",
    "db:migrate:remote": "wrangler d1 migrations apply cil-run --remote",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:unit": "node --test tests/plan.test.mjs tests/coachcalc.test.mjs",
    "test:ci": "node tests/run.mjs",
    "test:lh": "node tests/lighthouse.mjs",
    "test:e2e": "playwright test",
    "deploy:staging": "wrangler d1 migrations apply cil-run-staging --remote --env staging && wrangler deploy --env staging"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=20"
  }
}
